diff --git a/export.js b/export.js
index bfe74f5..e3ce623 100644
--- a/export.js
+++ b/export.js
@@ -1,8 +1,18 @@
-// Exports the report rows as text.
-const { ITEMS } = require("./report");
-
-function exportRows() {
-  return ITEMS.map((i) => formatRow(i)).join("\n");
+const { ITEMS, COLUMNS, reportText } = require("./report");
+function cell(v) {
+  let s = String(v);
+  if (/^[=+\-@\t\r]/.test(s)) s = "'" + s;
+  if (/[",\r\n]/.test(s)) s = '"' + s.replace(/"/g, '""') + '"';
+  return s;
 }
-
-module.exports = { exportRows };
+const FORMATS = {
+  text: { type: "text/plain", render: () => reportText() },
+  csv: { type: "text/csv", render: () => [COLUMNS.map((c) => cell(c.header)).join(","), ...ITEMS.map((i) => COLUMNS.map((c) => cell(i[c.key])).join(","))].join("\n") },
+  json: { type: "application/json", render: () => JSON.stringify(ITEMS.map((i) => Object.fromEntries(COLUMNS.map((c) => [c.key, i[c.key]])))) },
+};
+function exportRows(format = "text") {
+  const f = FORMATS[format];
+  if (!f) throw new Error("unknown format: " + format);
+  return f.render();
+}
+module.exports = { FORMATS, exportRows };
